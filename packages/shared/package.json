{
  "name": "@nexussklad/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts for NexusSklad",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "codegen:openapi": "openapi-typescript ../../docs/openapi_v1.yaml -o ./src/generated/openapi.ts",
    "codegen:openapi:check": "./check_openapi_codegen.sh"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.8.2"
  }
}
